# Copy to .env. AWS credentials come from SSO, never from this file.
# Blank MODEL_ID selects the provider-specific value below.
MODEL_PROVIDER=bedrock
MODEL_ID=
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
OLLAMA_MODEL_ID=qwen3:4b
OLLAMA_VISION_MODEL_ID=qwen3-vl:4b
ANTHROPIC_MODEL_ID=claude-haiku-5-5
OPENAI_MODEL_ID=gpt-6-luna
LITELLM_MODEL_ID=ollama_chat/qwen3:4b
OLLAMA_HOST=http://localhost:11434
AWS_PROFILE=nimbus-course
AWS_REGION=us-east-1
MODEL_MAX_TOKENS=512
MODEL_TEMPERATURE=0
# These hosted-provider keys are optional; leave blank for Ollama or Bedrock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LITELLM_API_KEY=
# Supply dated prices per million tokens to show an estimate; blank means unknown.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
# Consent stays enabled. Never set this to true for the course.
BYPASS_TOOL_CONSENT=false
# Tier 2 adapters: model IDs remain configurable and distinct from the chat model.
OLLAMA_EMBEDDING_MODEL_ID=embeddinggemma
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
NIMBUS_KNOWLEDGE_BASE_ID=
NIMBUS_SESSION_BUCKET=
AGENTCORE_MEMORY_ID=
MEM0_TELEMETRY=false
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
